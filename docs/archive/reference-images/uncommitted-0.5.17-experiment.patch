+internal fun resolveCastMember(token: String, cast: List<StoryCharacter>): StoryCharacter? {
+    val key = token.trim()
+    if (key.isBlank()) return null
+    return cast.firstOrNull { it.id == key || it.name == key || key in it.aliases }
+}
